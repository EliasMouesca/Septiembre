<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/app_widget_background"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@android:color/transparent">
    <ImageView
        android:id="@+id/fotoWidget"
        android:contentDescription="@null"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/estilo_marco"
        android:scaleType="fitCenter"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>

    <TextView
        android:id="@+id/septiembre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@+id/fotoWidget"
        android:layout_alignTop="@+id/faltanTV"
        android:layout_alignEnd="@+id/fotoWidget"
        android:layout_alignBottom="@+id/fotoWidget"
        android:fontFamily="casual"
        android:gravity="center"
        android:text="@string/septiembre"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="25sp"
        android:textStyle="bold"
        android:visibility="invisible" />
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/faltanTV"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="60dp"
        android:layout_alignTop="@+id/fotoWidget"
        android:layout_alignBottom="@+id/fotoWidget"
        android:fontFamily="casual"
        android:textAlignment="center"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_alignStart="@+id/fotoWidget"
        android:layout_alignEnd="@+id/fotoWidget"/>
    <TextView
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:id="@+id/remainingTV"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="0dp"
        android:text="@string/widget_days_placeholder"
        android:layout_alignTop="@+id/faltanTV"
        android:layout_alignBottom="@+id/fotoWidget"
        android:fontFamily="casual"
        android:textAlignment="center"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_alignStart="@+id/fotoWidget"
        android:layout_alignEnd="@+id/fotoWidget"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/paraSepTV"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="-60dp"
        android:layout_alignTop="@+id/remainingTV"
        android:layout_alignBottom="@+id/fotoWidget"
        android:fontFamily="casual"
        android:textAlignment="center"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_alignStart="@+id/fotoWidget"
        android:layout_alignEnd="@+id/fotoWidget"/>
</RelativeLayout>
